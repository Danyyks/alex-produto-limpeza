# WhatsApp — número no formato internacional sem + (ex: 5511999999999)
VITE_WHATSAPP_NUMBER=55XXXXXXXXXXX

# Firebase — Web App config (Firebase Console → Configurações do projeto → Seus apps → SDK setup).
# Deixar em branco até o projeto Firebase existir: o app detecta a ausência e usa o catálogo
# local fixo (src/app/data/products.ts) como fallback — não quebra o build nem a loja.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — upload de foto de produto no admin (conta gratuita em cloudinary.com,
# não precisa de cartão). VITE_CLOUDINARY_CLOUD_NAME vem do Dashboard; o upload preset
# precisa ser criado manualmente em Settings → Upload → Upload presets, com
# "Signing Mode" = Unsigned. Deixar em branco desativa o upload de foto no admin
# (o resto do painel funciona normalmente).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Opcional: faz "pnpm dev" abrir automaticamente no navegador do sistema.
# Ex: BROWSER=chrome (Windows/Linux) ou BROWSER="google chrome" (macOS).
# BROWSER=chrome
